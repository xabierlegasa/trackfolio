# Production frontend image. Build context: monorepo root.
FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL=http://192.168.1.136:8080
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY trackfolio-front/package.json trackfolio-front/package-lock.json ./
RUN npm ci

COPY trackfolio-front/ ./
RUN npm run build

FROM nginx:alpine

COPY infra/production/nginx/front.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
